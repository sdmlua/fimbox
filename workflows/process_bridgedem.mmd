flowchart LR
    subgraph S1[" "]
        direction TB
        A["<b>Bridge Lines</b><br/>osm_bridges_subset.gpkg from data download<br/><b>or</b> your own bridge line file"]
        B["<b>LiDAR Fetch</b><br/>USGS 3DEP EPT point stream, buffered<br/>around each bridge, parallel per bridge"]
        A --> B
    end
    subgraph S2[" "]
        direction TB
        C["<b>Deck Rasters</b><br/>IDW-rasterized per-bridge elevation GeoTIFFs<br/>(skips bridges already done, resumable)"]
        D["<b>DEM Difference</b><br/>per pixel: LiDAR deck elevation<br/>&minus; AOI dem.tif"]
        C --> D
    end
    subgraph S3[" "]
        direction TB
        E["<b>Mosaic</b><br/>all bridge differences &rarr;<br/>one bridge_elev_diff.tif"]
        F["<b>Branch Processing</b><br/>heal_bridges_osm adds the difference<br/>onto the HAND raster so decks are<br/>not treated as water surface"]
        E --> F
    end
    B --> C
    D --> E
    style S1 fill:none,stroke:none
    style S2 fill:none,stroke:none
    style S3 fill:none,stroke:none
