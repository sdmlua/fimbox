flowchart LR
    subgraph S1[" "]
        direction TB
        A["<b>HUC Input</b><br/>single code &middot; Python list<br/>.lst / .csv file"]
        B["<b>Normalize</b><br/>strip + zero-pad + de-duplicate<br/>into a HUC8 set"]
        A --> B
    end
    subgraph S2[" "]
        direction TB
        C["<b>Match</b><br/>against the packaged lists<br/>fimbox/config/huc_lists/*.lst"]
        D["<b>HUCCheckResult</b><br/>n_total &middot; n_found<br/>n_missing &middot; missing_hucs"]
        C --> D
    end
    subgraph S3[" "]
        direction TB
        E["<b>strict=False</b><br/>warn on missing codes,<br/>processing continues"]
        F["<b>strict=True</b><br/>missing codes raise<br/>HUCValidationError, fail fast"]
        E ~~~ F
    end
    B --> C
    D --> E
    D --> F
    style S1 fill:none,stroke:none
    style S2 fill:none,stroke:none
    style S3 fill:none,stroke:none
