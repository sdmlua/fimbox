    end
    subgraph S2[" "]
        direction TB
        C["<b>Benchmark Query</b>: FIMbench<br/>anonymous S3 catalog search<br/>overlap % and km&sup2; per match"]
        D["<b>Benchmark Assets</b><br/>GeoTIFF + AOI GeoPackage<br/>downloaded into benchmark-data/"]
