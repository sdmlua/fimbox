flowchart LR
    subgraph S1[" "]
        direction TB
        A["<b>Candidate FIM</b><br/>flood extents in fim-outputs/<br/>from the fimgeneration module <b>or</b> your own"]
        B["<b>Query Filters</b><br/>AOI raster/boundary &middot; huc8 &middot; tier<br/>event date or range &middot; file name"]
