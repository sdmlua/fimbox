    end
    subgraph S3[" "]
        direction TB
        E["<b>Case Staging</b><br/>candidates + benchmark_*.tif<br/>into fim-evaluation/&lt;case&gt;/"]
        F["<b>EvaluateFIM</b>: FIMeval<br/>evaluation boundary &middot; PWB masking<br/>contingency map per candidate"]
        G["<b>Evaluation Outputs</b><br/>CSI &middot; POD &middot; FAR &middot; F1 CSVs &middot; plots<br/>optional building-level agreement"]
