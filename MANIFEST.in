# Keep large data assets and docs out of the sdist/build.
# Runtime data is fetched on demand via pooch, so it does not
# need to ship in the package. These files remain in the git repo.
prune data
prune docs
prune workflows
exclude uv.lock

# dist/ is committed to git, so setuptools-scm's file finder would otherwise
# pack every previously released wheel and tarball into the new sdist -- each
# build roughly doubling the one before it.
prune dist
global-exclude *.whl *.tar.gz
