# Keep docs out of the sdist/build. No reference data lives in the repo --
# fimbox.datasets fetches it from S3 -- so the only data to exclude is a local
# cache someone parked in the checkout.
prune docs
prune workflows
prune .fimbox_data
exclude uv.lock

# dist/ is committed to git, so setuptools-scm's file finder would otherwise
# pack every previously released wheel and tarball into the new sdist -- each
# build roughly doubling the one before it.
prune dist
global-exclude *.whl *.tar.gz
